# Absolute path on the host to your Lucid refresh token JSON (chmod 600).
# Mounted READ-ONLY: the token does not rotate, so the bridge never writes it.
LUCID_TOKEN_HOST_PATH=/absolute/path/to/lucid-token.json

# TeslaMate stack secrets — generate with `openssl rand -hex 32`.
TM_ENCRYPTION_KEY=
TM_DB_PASS=
TM_GRAFANA_PASS=
